{
  "expo": {
    "name": "Cannabis ConCiencia",
    "slug": "cannabis-con-ciencia-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-icon.png",
    "scheme": "cannabisconciencia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.aure.cannabisconciencia",
      "label": "Cannabis ConCiencia",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo.png"
    },
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0bf71ce5-a18f-41d0-9539-0ae0341dfaaf"
      }
    },
    "owner": "aurex",
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}
